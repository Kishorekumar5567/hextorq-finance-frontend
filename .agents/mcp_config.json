{
  "mcpServers": {
    "magicui": {
      "command": "npx",
      "args": [
        "-y",
        "@magicuidesign/mcp@latest"
      ]
    },
    "orshot": {
      "serverUrl": "https://mcp.orshot.com/mcp"
    },
    "ui9000": {
      "transport": "sse",
      "url": "https://mcp.ui9000.com/see",
      "serverUrl": "https://mcp.ui9000.com/see"
    },
    "21st": {
      "url": "https://21st.dev/api/mcp",
      "serverUrl": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "$API_KEY_21ST"
      }
    }
  }
}
